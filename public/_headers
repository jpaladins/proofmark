/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://*.opentimestamps.org https://*.eternitywall.com https://blockstream.info; frame-ancestors 'none'; base-uri 'self'; form-action 'none'
